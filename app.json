{
  "expo": {
    "name": "HoloGram",
    "slug": "hologram",
    "scheme": "hologram",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false
    },
    "android": {
      "package": "com.hologram.app",
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-screen-orientation"
    ],
    "extra": {
      "eas": {
        "projectId": "a0836d90-0389-4f6f-9c9f-f80f3a2b1920"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a0836d90-0389-4f6f-9c9f-f80f3a2b1920",
      "channel": "main"
    }
  }
}
